{
    "name": "m-adamski/symfony-phone-number-bundle",
    "description": "Bundle for Symfony which integrates with the libphonenumber library",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Maciej Adamski",
            "email": "m.adamski@ideacode.pl"
        }
    ],
    "require": {
        "php": ">=8.0.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "giggsey/libphonenumber-for-php": "^8.12",
        "symfony/form": "^6.0",
        "symfony/framework-bundle": "^6.0",
        "symfony/intl": "^6.0",
        "symfony/orm-pack": "^2.0",
        "symfony/twig-bundle": "^6.0",
        "symfony/validator": "^6.0"
    },
    "require-dev": {
        "kint-php/kint": "^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Adamski\\Symfony\\PhoneNumberBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adamski\\Symfony\\PhoneNumberBundleTests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
