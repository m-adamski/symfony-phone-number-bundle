{% block phone_number_widget -%}
    {% set validation_class = '' %}
    {% if valid == false %}
        {% set validation_class = ' is-invalid' %}
    {% endif %}

    {% set attr = attr|merge({class: (attr.class|default('') ~ ' row' ~ validation_class)|trim}) %}
    <div {{ block('widget_container_attributes') }}>
        <div class="col">
            {{- form_widget(form.country) -}}
        </div>
        <div class="col">
            {{- form_widget(form.number, {'attr': {'placeholder': attr.placeholder|default('')}}) -}}
        </div>
    </div>
{%- endblock phone_number_widget %}
